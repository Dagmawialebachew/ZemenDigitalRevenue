# Local-development template only. Never commit a populated .env file.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Telegram bot
BOT_TOKEN=
BOT_MODE=polling
BOT_USERNAME=
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
MINI_APP_URL=http://localhost:5173
MINI_APP_SESSION_SECRET=replace-with-at-least-32-random-characters
MINI_APP_AUTH_MAX_AGE_SECONDS=900
MINI_APP_SESSION_TTL_SECONDS=43200
MINI_APP_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://zemen:zemen_local_only@localhost:5432/zemen
DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=10
DB_MAX_INACTIVE_CONNECTION_LIFETIME_SECONDS=300

# Durable workers
WORKERS_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_QUEUES=default,telegram,delivery,automation,broadcast
WORKER_LISTEN_NOTIFY_ENABLED=true
WORKER_LEASE_SECONDS=180
WORKER_POLL_FALLBACK_SECONDS=10
WORKER_RECOVERY_INTERVAL_SECONDS=30
WORKER_RECOVERY_BATCH_SIZE=100
WORKER_RETRY_BASE_SECONDS=2
WORKER_RETRY_CAP_SECONDS=900
WORKER_ERROR_SLEEP_SECONDS=2
WORKER_SHUTDOWN_GRACE_SECONDS=20

# Private ZEMEN OPS Telegram group/forum
ADMIN_TELEGRAM_IDS=
ZEMEN_OPS_GROUP_ID=
ZEMEN_OPS_TOPIC_NEW_USERS=
ZEMEN_OPS_TOPIC_PAYMENTS=
ZEMEN_OPS_TOPIC_SALES=
ZEMEN_OPS_TOPIC_SUPPORT=
ZEMEN_OPS_TOPIC_ALERTS=

# Product file storage and public links
TELEGRAM_STORAGE_CHAT_ID=
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
PRODUCT_UPLOAD_MAX_MB=45
MARKETING_UPLOAD_MAX_MB=45

# Zemen Control
CONTROL_OWNER_KEY=replace-with-at-least-24-random-characters
CONTROL_SESSION_SECRET=replace-with-a-different-32-character-secret
CONTROL_SESSION_TTL_SECONDS=43200
CONTROL_ALLOWED_ORIGINS=http://localhost:5174
CONTROL_COOKIE_NAME=zemen_control_session
CONTROL_COOKIE_SECURE=false
CONTROL_LOGIN_MAX_ATTEMPTS=8
CONTROL_LOGIN_WINDOW_SECONDS=900
STATIC_APPS_ENABLED=false

# Payment policy gate. Keep false until the production payment surface is approved.
MANUAL_PAYMENT_IN_TELEGRAM_ENABLED=false
EXTERNAL_MANUAL_CHECKOUT_URL=
CBE_ACCOUNT_NAME=
CBE_ACCOUNT_NUMBER=
TELEBIRR_ACCOUNT_NAME=
TELEBIRR_NUMBER=
ORDER_TTL_MINUTES=180
COMMISSION_HOLD_DAYS=3

# Operations and marketing
OPS_API_KEY=replace-with-a-random-operations-key
OPS_MAINTENANCE_INTERVAL_SECONDS=60
OPS_MAINTENANCE_BATCH_SIZE=100
PAYMENT_REVIEW_STALE_MINUTES=15
DELIVERY_STALE_MINUTES=10
DELIVERY_JOB_MAX_ATTEMPTS=5
DELIVERY_MAX_TOTAL_ATTEMPTS=12
JOB_FAILURE_ALERTS_ENABLED=true
MARKETING_MAINTENANCE_INTERVAL_SECONDS=300
BROADCAST_DISPATCH_BATCH_SIZE=250
BROADCAST_SEND_MAX_ATTEMPTS=8

TELEGRAM_USE_BUTTON_STYLES=true
TELEGRAM_USE_RICH_MESSAGES=true
TELEGRAM_BUTTON_CUSTOM_EMOJI_ID=
